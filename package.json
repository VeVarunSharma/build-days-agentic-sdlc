{
  "name": "babazon",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "start": "node dist/server/index.js",
    "lint": "eslint . --ignore-pattern playwright.config.ts && eslint playwright.config.ts --parser-options \"{\\\"projectService\\\":{\\\"allowDefaultProject\\\":[\\\"playwright.config.ts\\\"],\\\"defaultProject\\\":\\\"tsconfig.server.json\\\"}}\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run --exclude tests/e2e/**",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "build": "tsc -p tsconfig.server.json && vite build",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:e2e"
  },
  "dependencies": {
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^4.1.11"
  }
}
