{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "1487248091050478138"
    }
  },
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for the Foundry account, project, and model deployment."
      }
    },
    "principalId": {
      "type": "string",
      "metadata": {
        "description": "Object ID of the participant identity that will create and invoke the prompt agent."
      }
    },
    "accountName": {
      "type": "string",
      "defaultValue": "[take(format('aibabazon{0}', uniqueString(resourceGroup().id)), 24)]",
      "minLength": 2,
      "maxLength": 48,
      "metadata": {
        "description": "Globally unique Microsoft Foundry account name."
      }
    },
    "projectName": {
      "type": "string",
      "defaultValue": "babazon-shopping-missions",
      "minLength": 2,
      "maxLength": 64,
      "metadata": {
        "description": "Microsoft Foundry project name."
      }
    },
    "projectDisplayName": {
      "type": "string",
      "defaultValue": "Babazon shopping missions",
      "metadata": {
        "description": "Display name shown for the Microsoft Foundry project."
      }
    },
    "modelName": {
      "type": "string",
      "defaultValue": "gpt-4.1-mini",
      "metadata": {
        "description": "Name of the chat model deployed to the Foundry account."
      }
    },
    "modelVersion": {
      "type": "string",
      "defaultValue": "2025-04-14",
      "metadata": {
        "description": "Version of the chat model deployment."
      }
    },
    "modelDeploymentName": {
      "type": "string",
      "defaultValue": "babazon-chat",
      "metadata": {
        "description": "Name used by applications and prompt agents to address the model deployment."
      }
    },
    "modelSkuName": {
      "type": "string",
      "defaultValue": "GlobalStandard",
      "metadata": {
        "description": "Model deployment SKU. Availability varies by subscription and region."
      }
    },
    "modelCapacity": {
      "type": "int",
      "defaultValue": 1,
      "minValue": 1,
      "metadata": {
        "description": "Small configurable model capacity. This does not assert that quota is available."
      }
    }
  },
  "variables": {
    "foundryUserRoleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '53ca6127-db72-4b80-b1b0-d745d6d5456d')]"
  },
  "resources": [
    {
      "type": "Microsoft.CognitiveServices/accounts",
      "apiVersion": "2025-06-01",
      "name": "[parameters('accountName')]",
      "location": "[parameters('location')]",
      "kind": "AIServices",
      "sku": {
        "name": "S0"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "allowProjectManagement": true,
        "customSubDomainName": "[toLower(parameters('accountName'))]",
        "disableLocalAuth": true,
        "publicNetworkAccess": "Enabled",
        "networkAcls": {
          "defaultAction": "Allow",
          "virtualNetworkRules": [],
          "ipRules": []
        }
      }
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/projects",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('accountName'), parameters('projectName'))]",
      "location": "[parameters('location')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "description": "Prompt-agent project for deterministic Babazon shopping mission proposals.",
        "displayName": "[parameters('projectDisplayName')]"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.CognitiveServices/accounts/deployments",
      "apiVersion": "2025-06-01",
      "name": "[format('{0}/{1}', parameters('accountName'), parameters('modelDeploymentName'))]",
      "sku": {
        "name": "[parameters('modelSkuName')]",
        "capacity": "[parameters('modelCapacity')]"
      },
      "properties": {
        "model": {
          "format": "OpenAI",
          "name": "[parameters('modelName')]",
          "version": "[parameters('modelVersion')]"
        },
        "versionUpgradeOption": "OnceCurrentVersionExpired"
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"
      ]
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), parameters('projectName'))]",
      "name": "[guid(resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), parameters('projectName')), parameters('principalId'), variables('foundryUserRoleDefinitionId'))]",
      "properties": {
        "principalId": "[parameters('principalId')]",
        "principalType": "User",
        "roleDefinitionId": "[variables('foundryUserRoleDefinitionId')]",
        "description": "Allows the workshop participant to create and invoke the Babazon prompt agent."
      },
      "dependsOn": [
        "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), parameters('projectName'))]"
      ]
    }
  ],
  "outputs": {
    "AZURE_RESOURCE_GROUP": {
      "type": "string",
      "value": "[resourceGroup().name]"
    },
    "AZURE_AI_ACCOUNT_NAME": {
      "type": "string",
      "value": "[parameters('accountName')]"
    },
    "AZURE_AI_ACCOUNT_ID": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName'))]"
    },
    "AZURE_AI_PROJECT_NAME": {
      "type": "string",
      "value": "[parameters('projectName')]"
    },
    "AZURE_AI_PROJECT_ID": {
      "type": "string",
      "value": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('accountName'), parameters('projectName'))]"
    },
    "AZURE_AI_PROJECT_ENDPOINT": {
      "type": "string",
      "value": "[format('{0}api/projects/{1}', reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName')), '2025-06-01').endpoint, parameters('projectName'))]"
    },
    "FOUNDRY_PROJECT_ENDPOINT": {
      "type": "string",
      "value": "[format('{0}api/projects/{1}', reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('accountName')), '2025-06-01').endpoint, parameters('projectName'))]"
    },
    "AZURE_AI_MODEL_DEPLOYMENT_NAME": {
      "type": "string",
      "value": "[parameters('modelDeploymentName')]"
    }
  }
}